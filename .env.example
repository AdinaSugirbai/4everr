# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Full database access. Never add NEXT_PUBLIC_ to this name and never commit the value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
